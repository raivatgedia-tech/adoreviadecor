# Copy this file to .env.local and fill in real values (see SANITY_SETUP.md).
# .env.local is already git-ignored by Next.js's default .gitignore — never commit it.

# Public — safe to expose to the browser, needed to read products.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret — only used by scripts/seed.ts, never sent to the browser.
# Create at sanity.io/manage -> your project -> API -> Tokens -> Add API token -> Editor.
SANITY_API_TOKEN=
